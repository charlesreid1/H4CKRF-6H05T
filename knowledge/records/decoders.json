  {
    "id": "decoder-nrzi",
    "name": "NRZI (non-return-to-zero inverted)",
    "aliases": ["NRZ-I", "NRZ-mark", "NRZ-space"],
    "category": "decoder_family",
    "region": "universal",
    "era_bounds": ["1950-01-01", null],
    "still_effective_2026": true,
    "confidence": "primary",
    "citations": ["proakis-digital-comm"],
    "technical_body": {
      "encoding_rule": "A transition at the start of a symbol encodes one value; no transition encodes the other. Value = XOR of previous level.",
      "conventions": {
        "nrz_mark": "1 = transition, 0 = no transition",
        "nrz_space": "0 = transition, 1 = no transition"
      },
      "self_clocking": "partial - long runs of 0s (NRZ-mark) have no transitions; needs bit-stuffing (HDLC) or a preamble",
      "canonical_use_cases": [
        "HDLC / AX.25 packet radio (Bell 202 AFSK-1200, FSK-9600)",
        "USB PHY (with bit-stuffing after 6 consecutive 1s)",
        "some ISO/IEC 14443 (RFID) downlinks"
      ],
      "bit_stuffing_note": "HDLC/AX.25 insert a 0 after 5 consecutive 1s to preserve clock recovery; the decoder must strip it before payload assembly."
    },
    "hackrf_role": "analyze",
    "blocked_tx": false,
    "tools_upstream": ["analyze_iq_symbols"],
    "tools_downstream": ["hackrf-agent decode_nrz", "hackrf-agent decode_ax25"],
    "see_also": ["decoder-nrz", "decoder-hdlc-bit-stuffing", "protocol-ax25"]
  },
  {
    "id": "decoder-hdlc-bit-stuffing",
    "name": "HDLC bit-stuffing / de-stuffing",
    "aliases": ["zero-bit insertion", "HDLC framing"],
    "category": "decoder_family",
    "region": "universal",
    "era_bounds": ["1975-01-01", null],
    "still_effective_2026": true,
    "confidence": "primary",
    "citations": ["ax25-spec"],
    "technical_body": {
      "rule": "Insert a 0 bit after every 5 consecutive 1s in the payload. The 0x7E flag (01111110) is thus unambiguous as a frame delimiter.",
      "self_clocking": "when combined with NRZI, the stuffed 0 guarantees an edge and preserves clock recovery",
      "canonical_use_cases": ["AX.25 packet radio", "SDLC / HDLC WAN framing", "AIS (HDLC on GMSK)"]
    },
    "hackrf_role": "analyze",
    "blocked_tx": false,
    "tools_downstream": ["hackrf-agent decode_ax25", "gr-ais"],
