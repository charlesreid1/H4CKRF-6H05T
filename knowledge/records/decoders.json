      "advantages": "carrier-independent (only needs I/Q); works with modest SNR",
      "canonical_use_cases": ["BPSK / QPSK receivers", "GNU Radio symbol_sync block (Gardner variant)"]
    },
    "hackrf_role": "analyze",
