[
  {
    "id": "decoder-manchester",
    "name": "Manchester (IEEE 802.3 / G.E. Thomas)",
    "aliases": ["biphase-L", "biphase level", "Manchester encoding"],
    "category": "decoder_family",
    "region": "universal",
    "era_bounds": ["1949-01-01", null],
    "still_effective_2026": true,
    "confidence": "primary",
    "citations": ["proakis-digital-comm", "hackrf-agent-repo"],
    "technical_body": {
      "encoding_rule": "Each bit is transmitted as two half-symbols; a transition mid-bit encodes the value.",
      "conventions": {
        "ieee_802_3": "0 = low-to-high transition, 1 = high-to-low transition",
        "g_e_thomas": "0 = high-to-low transition, 1 = low-to-high transition (inverse)"
      },
      "self_clocking": true,
      "dc_balance": "zero-DC (equal high and low time per bit)",
      "preamble_typical": "0xAA/0x55 alternating (mid-bit transitions produce a clean clock spike)",
      "symbol_rate_range_bps": [100, 1000000],
      "canonical_use_cases": [
        "OOK keyfobs at 315/433 MHz (rolling code + fixed code)",
        "TPMS (Schrader, Continental)",
        "10BASE-T Ethernet PHY",
        "some weather stations (Acurite 592TXR, Fine Offset WH1080)"
      ],
      "polarity_recovery": "Try both polarity assumptions; the one that yields a valid preamble/CRC wins."
    },
    "hackrf_role": "analyze",
    "blocked_tx": false,
    "tools_upstream": ["analyze_iq_symbols"],
    "tools_downstream": ["hackrf-agent decode_manchester", "urh"],
    "see_also": ["decoder-diff-manchester", "decoder-nrz", "modulation-ook"]
  },
