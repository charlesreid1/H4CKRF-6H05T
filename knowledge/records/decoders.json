    "citations": ["proakis-digital-comm", "rice-digital-comm"],
    "technical_body": {
      "rule": "Sample twice per symbol; timing error e = Re[(x_mid) * (x_prev - x_curr)^*]. Feeds an NCO that corrects sample instant toward the eye peak.",
