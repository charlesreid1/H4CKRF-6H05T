{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "envelope.schema.json",
  "title": "H4CKRF-6H05T knowledge record envelope",
  "description": "Every record in knowledge/records/*.json (except bibliography.json) MUST conform to this envelope.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Kebab-case unique-within-file identifier."
    },
    "name": {"type": "string", "minLength": 1},
    "aliases": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "category": {
      "type": "string",
      "enum": [
        "band_allocation",
        "modulation_family",
        "symbol_encoding",
        "protocol_phy",
        "iq_format",
        "decoder_family",
        "fec_code",
        "crypto_in_rf",
        "keyfob_system",
        "sdr_hardware",
        "sdr_tool",
        "dsp_concept",
        "regulatory",
        "antenna",
        "defense_and_detection",
        "bibliography",
        "meta"
      ]
    },
    "region": {"type": "string", "minLength": 1},
    "era_bounds": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "oneOf": [
          {"type": "null"},
          {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
        ]
      }
    },
    "still_effective_2026": {"type": "boolean"},
    "confidence": {
      "type": "string",
      "enum": ["primary", "secondary", "community", "folklore"]
    },
    "citations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "see_also": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "disputed": {"type": "object"},
    "technical_body": {"type": "object"},
    "hackrf_role": {"type": "string"},
    "blocked_tx": {"type": "boolean"},
    "tools_upstream": {"type": "array", "items": {"type": "string"}},
    "tools_downstream": {"type": "array", "items": {"type": "string"}},
    "flag_pattern_hint": {"type": "string"},
    "typical_use_cases": {"type": "array", "items": {"type": "string"}},
    "hackrf_relationship": {"type": "string"}
  },
  "required": ["id", "name", "category", "confidence", "citations"],
  "additionalProperties": true
}
